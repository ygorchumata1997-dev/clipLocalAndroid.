<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◉  CLIPLOCAL"
            android:textColor="@color/cyan"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="Salve vídeos.&#10;Sem complicação."
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="32sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cole um link do X ou compartilhe um post diretamente com o app."
            android:textColor="@color/muted"
            android:textSize="15sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LINK DO POST"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="@color/cyan" />
            <EditText
                android:id="@+id/linkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="62dp"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:hint="https://x.com/usuario/status/..."
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:inputType="textUri"
                android:singleLine="false"
                android:maxLines="3"
                android:textSize="14sp" />
            <Button
                android:id="@+id/pasteButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/secondary_bg"
                android:backgroundTint="@null"
                android:text="COLAR LINK"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textStyle="bold" />
            <Button
                android:id="@+id/downloadButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/primary_bg"
                android:backgroundTint="@null"
                android:text="⬇  BAIXAR VÍDEO"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/secondary_bg"
                android:backgroundTint="@null"
                android:text="Cancelar download"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/cyan"
                android:progressBackgroundTint="#1E3A50" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="0%"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pronto para baixar."
                android:textSize="13sp"
                android:textColor="@color/muted" />
            <Button
                android:id="@+id/openButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/secondary_bg"
                android:backgroundTint="@null"
                android:text="ABRIR ÚLTIMO VÍDEO"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="ARMAZENAMENTO LOCAL"
            android:textColor="@color/cyan"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Downloads / ClipLocal&#10;Sem envio para servidor externo."
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="21dp"
            android:background="@drawable/secondary_bg"
            android:backgroundTint="@null"
            android:text="Atualizar mecanismo de download"
            android:textAllCaps="false"
            android:textColor="@color/white" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="26dp"
            android:text="Use apenas vídeos que você tem direito de salvar. Posts privados ou que exigem login podem não funcionar."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
